#
# Copy to .env and adjust values. This file is gitignored.
#

# ─────────────────────────────────────────────────────────────────────────────
# Core paths (used by this repo)
# ─────────────────────────────────────────────────────────────────────────────

# Development root directory
DEV_HOME="$HOME/Developer"

# Cursor editor profile (keeps settings/extensions outside repo)
CURSOR_APP_NAME="Cursor"
CURSOR_USER_DATA_DIR="$DOTLOC/cursor/profile"
CURSOR_EXTENSIONS_DIR="$CURSOR_USER_DATA_DIR/Extensions"

# whisper.cpp build directory (for scripts/whisper_transcription.sh)
WHISPER_CPP_DIR="$DEV_HOME/tools/whisper.cpp"

# ─────────────────────────────────────────────────────────────────────────────
# External tools (optional, not used by dotfiles directly)
# ─────────────────────────────────────────────────────────────────────────────

# Claude CLI override
# CLAUDE_BINARY="$HOME/.claude/local/claude"
# CLAUDE_CODE_SHELL_PREFIX="zsh -c"

# Tesseract OCR data path
# TESSDATA_PREFIX="$DEV_HOME/ml/tessdata/"

# LLVM debugger
# LLDB_EXEC="/opt/homebrew/opt/llvm/bin/lldb-vscode"
