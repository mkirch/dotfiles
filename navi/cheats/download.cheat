% yt-dlp, ytdl, youtube

# Download video (best quality)
yt-dlp <url>

# Download audio only (mp3)
yt-dlp --extract-audio --audio-format mp3 <url>

# Download audio only (best quality)
yt-dlp -f 'ba' -x <url>

# Download with subtitles
yt-dlp --write-sub --write-auto-sub --sub-langs en <url>

# Download playlist
yt-dlp --yes-playlist <url>

# Download specific playlist items
yt-dlp --playlist-items <range> <url>

# List available formats
yt-dlp -F <url>

# Download specific format
yt-dlp -f <format_id> <url>

# Download with custom filename
yt-dlp -o '%(title)s.%(ext)s' <url>

# Download with aria2c (faster)
yt-dlp --downloader aria2c <url>

# Download thumbnail
yt-dlp --write-thumbnail --skip-download <url>

# Get video info as json
yt-dlp -j <url>

# Download with cookies from browser
yt-dlp --cookies-from-browser <browser> <url>

$ browser: echo -e "chrome\nbrave\nfirefox\nsafari"

# Limit download speed
yt-dlp -r <rate> <url>

$ rate: echo -e "1M\n5M\n10M"

# Download age-restricted with cookies
yt-dlp --cookies-from-browser chrome <url>

% aria2c, aria

# Fast download (16 connections)
aria2c -x 16 -s 16 <url>

# Download with custom filename
aria2c -o <filename> <url>

# Resume download
aria2c -c <url>

# Download from file with URLs
aria2c -i <urlfile>

# Limit download speed
aria2c --max-download-limit=<rate> <url>

$ rate: echo -e "1M\n5M\n10M\n0"

# Download torrent
aria2c <torrent_file>

# Download magnet link
aria2c '<magnet_link>'

% wget

# Download file
wget <url>

# Download with custom filename
wget -O <filename> <url>

# Resume download
wget -c <url>

# Mirror website
wget -m -p -E -k -np <url>

# Download recursively (depth limited)
wget -r -l <depth> <url>

# Download documents from page (wg_docs alias)
wget -r -l 1 --span-hosts -nd -np -e robots=off -P files -A ".pdf,.html,.doc,.docx,.xls,.xlsx" <url>

# Spider mode (check links only)
wget --spider -r <url>

# Download with rate limit
wget --limit-rate=<rate> <url>

$ rate: echo -e "100k\n500k\n1m\n5m"

# Download with custom user agent
wget --user-agent="Mozilla/5.0" <url>

# Download all files matching pattern
wget -r -np -nd -A "<pattern>" <url>

# Quiet download (no output)
wget -q <url>

# Download to stdout
wget -O - <url>

% gallery-dl

# Download gallery
gallery-dl <url>

# Download with metadata
gallery-dl --write-metadata <url>

# List supported extractors
gallery-dl --list-extractors

# Download to specific directory
gallery-dl -d <dir> <url>

# Download with filename format
gallery-dl -f '<format>' <url>

# Download with rate limit
gallery-dl -r <rate> <url>

% curl

# GET request
curl <url>

# GET with headers shown
curl -i <url>

# POST request with data
curl -X POST -d '<data>' <url>

# POST JSON
curl -X POST -H "Content-Type: application/json" -d '<json>' <url>

# Download file
curl -O <url>

# Download with custom filename
curl -o <filename> <url>

# Follow redirects
curl -L <url>

# Send header
curl -H "<header>: <value>" <url>

# Basic auth
curl -u <user>:<pass> <url>

# Silent mode
curl -s <url>

# Show only response headers
curl -I <url>

# Upload file
curl -F "file=@<filepath>" <url>

# Save cookies
curl -c <cookiefile> <url>

# Use cookies
curl -b <cookiefile> <url>

# Verbose output
curl -v <url>

# Timing info
curl -w "@curl-format.txt" -o /dev/null -s <url>
