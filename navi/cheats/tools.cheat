% fd, find

# Find by name pattern
fd <pattern>

# Find by extension
fd -e <ext>

$ ext: echo -e "py\njs\nts\nrs\ngo\njson\nmd\ntxt\nsh\nyaml\ntoml"

# Find hidden files too
fd -H <pattern>

# Find only directories
fd -t d <pattern>

# Find only files
fd -t f <pattern>

# Find and execute command
fd <pattern> -x <cmd> {}

# Find files modified within time
fd --changed-within <time>

$ time: echo -e "1h\n1d\n7d\n30d"

# Find files larger than size
fd -S +<size>

$ size: echo -e "1M\n10M\n100M\n1G"

# Find and delete
fd <pattern> -x rm {}

# Find with max depth
fd -d <depth> <pattern>

% rg, ripgrep, grep

# Search with context
rg -C <n> "<pattern>"

# Search case insensitive
rg -i "<pattern>"

# Search specific file type
rg -t <type> "<pattern>"

$ type: echo -e "py\njs\nts\nrust\ngo\njson\nmd\nyaml\ntoml"

# Search and show only filenames
rg -l "<pattern>"

# Search hidden files
rg --hidden "<pattern>"

# Search with regex
rg -e "<regex>"

# Count matches per file
rg -c "<pattern>"

# Search compressed files (rgz alias)
rg -zi "<pattern>"

# Invert match (lines not matching)
rg -v "<pattern>"

# Search multiline
rg -U "<pattern>"

# Search and replace (preview)
rg "<pattern>" -r "<replacement>"

# Search in specific path
rg "<pattern>" <path>

% eza, ls

# List with git status (ll alias)
eza -lah --icons --git --git-repos --group-directories-first

# Quick list (l alias)
eza -lah --icons --group-directories-first --git-ignore

# Tree view (lt alias)
eza -Tah --icons --git-ignore --group-directories-first

# Tree with depth limit
eza -T -L <levels> --icons

$ levels: echo -e "2\n3\n4\n5"

# Sort by modified time
eza -la --sort=modified

# Sort by size
eza -la --sort=size

# Only directories
eza -D

# Only files
eza -f

# Show extended attributes
eza -l@

% bat, cat

# View with line numbers
bat -n <file>

# View specific line range
bat -r <start>:<end> <file>

# Plain output (batp alias)
bat -p <file>

# Show non-printable characters
bat -A <file>

# View with specific language
bat -l <lang> <file>

$ lang: echo -e "json\nyaml\npy\njs\nts\nrs\ngo\nsh\nmd"

# Diff two files
bat --diff <file1> <file2>

% dust, du

# Disk usage current dir
dust

# Disk usage with depth
dust -d <n>

# Disk usage of path
dust <path>

# Disk usage reverse order
dust -r

# Only show directories
dust -D

% procs, ps

# List all processes
procs

# Search by name
procs <name>

# Tree view
procs --tree

# Watch mode
procs --watch

# Sort by CPU
procs --sortd cpu

# Sort by memory
procs --sortd mem

% btm, bottom, top, htop

# Bottom (full)
btm --enable_gpu_memory -g -a --mem_as_value --color gruvbox

# Bottom (basic view)
btm --basic --enable_gpu_memory

# Bottom with network bytes
btm --network_use_bytes --network_use_log

% zoxide, z, cd

# Jump to directory
z <query>

# Jump interactively (with fzf)
zi

# Add directory
zoxide add <path>

# Remove directory
zoxide remove <path>

# List frecent directories
zoxide query -l

# Show score for query
zoxide query <query>

% hyperfine, benchmark, tm

# Benchmark command
hyperfine '<cmd>'

# Benchmark with warmup
hyperfine --warmup 3 '<cmd>'

# Compare two commands
hyperfine '<cmd1>' '<cmd2>'

# Benchmark with shell
hyperfine -S zsh '<cmd>'

# Export results to markdown
hyperfine '<cmd>' --export-markdown <file>.md

% tokei, cloc

# Count lines of code
tokei

# Count for specific path
tokei <path>

# Show files
tokei --files

# Sort by lines
tokei --sort lines

% bfg, git history

# Remove file from history
bfg --delete-files <filename>

# Remove folder from history
bfg --delete-folders <folder>

# Replace text in history
bfg --replace-text <replacements.txt>

# Strip blobs bigger than size
bfg --strip-blobs-bigger-than <size>

$ size: echo -e "1M\n10M\n50M\n100M"

% fzf, fuzzy

# Fuzzy find files
fd --type f | fzf --preview 'bat --color=always {}'

# Fuzzy find and open in editor
fd --type f | fzf --preview 'bat --color=always {}' | xargs -o nvim

# Fuzzy grep (interactive)
rg --color=always --line-number "" | fzf --ansi --preview 'bat --color=always {1} --highlight-line {2}' --delimiter ':'

# Fuzzy cd
cd "$(fd --type d | fzf)"

# Fuzzy kill process
kill -9 $(procs | fzf | awk '{print $1}')

# Fuzzy git branch
git switch $(git branch | fzf | tr -d ' ')

# Fuzzy git log
git log --oneline | fzf --preview 'git show {1}'

% lazygit, lg

# Open lazygit
lazygit

# Open lazygit in specific repo
lazygit -p <path>

# Open lazygit with specific work tree
lazygit -w <worktree>

% delta, diff

# Git diff with delta (configured via git config)
git diff

# Side-by-side diff
delta --side-by-side <file1> <file2>

# Diff two files
delta <file1> <file2>

% sd, sed

# Replace in file
sd '<find>' '<replace>' <file>

# Replace all occurrences
sd -s '<find>' '<replace>' <file>

# Preview changes (dry run)
sd -p '<find>' '<replace>' <file>

# Replace with regex
sd '<regex>' '<replace>' <file>

# Replace in multiple files
fd -e py | xargs sd '<find>' '<replace>'

% glow, markdown

# View markdown file
glow <file>

# View with pager
glow -p <file>

# View in style
glow -s <style> <file>

$ style: echo -e "dark\nlight\nauto\nnotty"

% watchexec, watch

# Run command on file changes
watchexec -e <ext> -- <command>

$ ext: echo -e "py\njs\nts\nrs\ngo\nsh"

# Run with debounce
watchexec --debounce <ms> -- <command>

# Watch specific paths
watchexec -w <path> -- <command>

# Clear screen before each run
watchexec -c -- <command>

# Restart command (for servers)
watchexec -r -- <command>

% rga, ripgrep-all

# Search in PDFs, archives, etc
rga '<pattern>'

# Search specific file types
rga --type <type> '<pattern>'

# Search in path
rga '<pattern>' <path>

% viu, image

# View image in terminal
viu <image>

# View with specific width
viu -w <width> <image>

$ width: echo -e "40\n60\n80\n100"

# View with specific height
viu -h <height> <image>

# View transparent background
viu -t <image>

% curlie, http

# GET request
curlie <url>

# POST with JSON
curlie post <url> key=value

# POST with JSON body
curlie post <url> < data.json

# With headers
curlie -H 'Authorization: Bearer <token>' <url>

# Verbose
curlie -v <url>

% navi, cheatsheet

# Update community cheats
cd ~/.local/share/navi/cheats/community && git pull

# Update tldr cache
tldr --update

# Edit personal cheats
nvim ~/Developer/dotfiles/navi/cheats/

# Browse navi repos
navi repo browse

# Add a cheat repo
navi repo add <user>/<repo>

% terraform, tf

# Initialize
terraform init

# Plan
terraform plan

# Apply
terraform apply

# Apply auto-approve
terraform apply -auto-approve

# Destroy
terraform destroy

# Format
terraform fmt

# Validate
terraform validate

# Show state
terraform show

# List resources
terraform state list

# Import resource
terraform import <resource> <id>
