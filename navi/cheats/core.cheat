% tar

# Extract .tar.gz
tar -xzvf <archive>

# Extract .tar.xz
tar -xJvf <archive>

# Extract .tar.bz2
tar -xjvf <archive>

# Extract to specific directory
tar -xzvf <archive> -C <dir>

# Create .tar.gz
tar -czvf <name>.tar.gz <input>

# List contents without extracting
tar -tzvf <archive>

% ffmpeg

# Convert to gif (high quality)
ffmpeg -i <input> -vf "fps=<fps>,scale=<width>:-1:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" <output>.gif

$ fps: echo -e "10\n15\n24\n30"
$ width: echo -e "480\n640\n720\n1080"

# Quick gif (lower quality, faster)
ffmpeg -i <input> -vf "fps=15,scale=640:-1" -loop 0 <output>.gif

# Extract audio to mp3
ffmpeg -i <input> -vn -acodec libmp3lame -q:a 2 <output>.mp3

# Extract audio to flac (lossless)
ffmpeg -i <input> -vn -acodec flac <output>.flac

# Trim video by start time and duration
ffmpeg -i <input> -ss <start> -t <duration> -c copy <output>

# Trim video by start and end time
ffmpeg -i <input> -ss <start> -to <end> -c copy <output>

# Convert to h265/HEVC (smaller files)
ffmpeg -i <input> -c:v libx265 -crf <crf> -preset medium -c:a aac <output>.mp4

$ crf: echo -e "23\n28\n32"

# Compress video (h264)
ffmpeg -i <input> -c:v libx264 -crf <crf> -preset slow -c:a aac <output>.mp4

# Scale/resize video
ffmpeg -i <input> -vf "scale=<width>:<height>" <output>

$ height: echo -e "-1\n720\n1080\n1440\n2160"

# Concatenate videos (same codec)
ffmpeg -f concat -safe 0 -i <filelist> -c copy <output>

# Add subtitles (burn in)
ffmpeg -i <input> -vf "subtitles=<srtfile>" <output>

# Extract frames as images
ffmpeg -i <input> -vf "fps=1" frame_%04d.png

# Convert images to video
ffmpeg -framerate 24 -pattern_type glob -i '*.png' -c:v libx264 -pix_fmt yuv420p <output>.mp4

# Get video info
ffprobe -v quiet -print_format json -show_format -show_streams <input>

% git

# Interactive rebase last n commits
git rebase -i HEAD~<n>

# Undo last commit, keep changes staged
git reset --soft HEAD~1

# Undo last commit, keep changes unstaged
git reset HEAD~1

# Undo last commit, discard changes (dangerous)
git reset --hard HEAD~1

# Amend last commit message
git commit --amend -m "<message>"

# Amend last commit, add staged changes
git commit --amend --no-edit

# Stash with message
git stash push -m "<message>"

# Stash including untracked files
git stash push -u -m "<message>"

# Apply specific stash
git stash apply stash@{<n>}

# Pop specific stash
git stash pop stash@{<n>}

# Show stash diff
git stash show -p stash@{<n>}

# List stashes
git stash list

# Cherry-pick commit
git cherry-pick <commit>

# Cherry-pick without committing
git cherry-pick -n <commit>

# Find commit that introduced bug (bisect)
git bisect start && git bisect bad && git bisect good <commit>

# Clean untracked files (dry run)
git clean -n -d

# Clean untracked files (force)
git clean -f -d

# Show commits by author
git log --author="<author>" --oneline

# Show file history
git log --follow -p -- <file>

# Show who changed each line
git blame <file>

# Create and switch to new branch
git switch -c <branch>

# Delete local branch
git branch -d <branch>

# Delete remote branch
git push origin --delete <branch>

# Fetch and prune deleted remote branches
git fetch --prune

# Squash last n commits
git reset --soft HEAD~<n> && git commit

# Revert a commit (creates new commit)
git revert <commit>

# Show diff of staged changes
git diff --staged

# Show changed files only
git diff --name-only

# Restore file from specific commit
git restore --source=<commit> -- <file>

% rsync

# Sync with progress
rsync -avz --progress <src>/ <dest>/

# Sync and delete extraneous files in dest
rsync -avz --delete <src>/ <dest>/

# Dry run (show what would change)
rsync -avzn <src>/ <dest>/

# Exclude pattern
rsync -avz --exclude='<pattern>' <src>/ <dest>/

# Exclude multiple patterns from file
rsync -avz --exclude-from='<excludefile>' <src>/ <dest>/

# Sync via SSH
rsync -avz -e ssh <src>/ <user>@<host>:<dest>/

# Sync via SSH with custom port
rsync -avz -e 'ssh -p <port>' <src>/ <user>@<host>:<dest>/

# Resume partial transfers
rsync -avz --partial --progress <src>/ <dest>/

# Limit bandwidth (KB/s)
rsync -avz --bwlimit=<kbps> <src>/ <dest>/

% docker

# Run interactive container
docker run -it --rm <image> /bin/bash

# Run with port mapping
docker run -d -p <hostport>:<containerport> <image>

# Run with volume mount
docker run -v <hostpath>:<containerpath> <image>

# Run with environment variable
docker run -e <VAR>=<value> <image>

# List running containers
docker ps

# List all containers
docker ps -a

# Stop container
docker stop <container>

# Stop all running containers
docker stop $(docker ps -q)

# Remove container
docker rm <container>

# Remove all stopped containers
docker container prune -f

# View logs (follow)
docker logs -f <container>

# View logs (last n lines)
docker logs --tail <n> <container>

# Execute command in running container
docker exec -it <container> /bin/bash

# Copy file from container
docker cp <container>:<path> <localpath>

# Copy file to container
docker cp <localpath> <container>:<path>

# Build image
docker build -t <name>:<tag> .

# Build with no cache
docker build --no-cache -t <name>:<tag> .

# List images
docker images

# Remove image
docker rmi <image>

# Remove unused images
docker image prune -a -f

# Remove all unused data (containers, networks, images)
docker system prune -a -f

# Show container resource usage
docker stats

# Inspect container
docker inspect <container>

# Docker compose up
docker compose up -d

# Docker compose down
docker compose down

# Docker compose down and remove volumes
docker compose down -v

# Docker compose logs
docker compose logs -f

# Docker compose rebuild
docker compose up -d --build
