% exiftool, metadata

# Show all metadata
exiftool <file>

# Show specific tag
exiftool -<tag> <file>

# Remove all metadata
exiftool -all= <file>

# Remove GPS data
exiftool -gps:all= <file>

# Copy metadata from one file to another
exiftool -TagsFromFile <source> <dest>

# Rename by date taken
exiftool '-filename<DateTimeOriginal' -d '%Y%m%d_%H%M%S%%-c.%%e' <file>

# Set date taken
exiftool -DateTimeOriginal='<datetime>' <file>

# Show common photo info
exiftool -common <file>

# Export to JSON
exiftool -json <file>

# Recursive (all files in dir)
exiftool -r <dir>

# Show GPS coordinates
exiftool -gpslatitude -gpslongitude <file>

% imagemagick, convert

# Resize image
convert <input> -resize <width>x<height> <output>

# Resize by percentage
convert <input> -resize <percent>% <output>

$ percent: echo -e "50\n75\n25"

# Convert format
convert <input> <output>

# Compress JPEG
convert <input> -quality <quality> <output>

$ quality: echo -e "85\n75\n60"

# Create thumbnail
convert <input> -thumbnail 200x200 <output>

# Crop image
convert <input> -crop <width>x<height>+<x>+<y> <output>

# Add border
convert <input> -border <size> -bordercolor <color> <output>

$ color: echo -e "white\nblack\ngray"

# Rotate image
convert <input> -rotate <degrees> <output>

$ degrees: echo -e "90\n180\n270\n-90"

# Strip metadata
convert <input> -strip <output>

# Combine images horizontally
convert +append <img1> <img2> <output>

# Combine images vertically
convert -append <img1> <img2> <output>

# Create PDF from images
convert *.png <output>.pdf

# Extract pages from PDF as images
convert -density 300 <input>.pdf <output>_%04d.png

% pandoc, convert docs

# Markdown to HTML
pandoc <input>.md -o <output>.html

# Markdown to PDF
pandoc <input>.md -o <output>.pdf

# Markdown to DOCX
pandoc <input>.md -o <output>.docx

# DOCX to Markdown
pandoc <input>.docx -o <output>.md

# HTML to Markdown
pandoc <input>.html -o <output>.md

# With table of contents
pandoc --toc <input>.md -o <output>.pdf

# With custom CSS
pandoc -c <style>.css <input>.md -o <output>.html

# Standalone HTML
pandoc -s <input>.md -o <output>.html

% tesseract, ocr

# OCR image to stdout
tesseract <image> stdout

# OCR image to text file
tesseract <image> <output>

# OCR with language
tesseract -l <lang> <image> <output>

$ lang: echo -e "eng\ndeu\nfra\nspa\nchi_sim\njpn"

# OCR to searchable PDF
tesseract <image> <output> pdf

# OCR to hOCR (HTML)
tesseract <image> <output> hocr

# List available languages
tesseract --list-langs

% mpv, video player

# Play video
mpv <file>

# Play at speed
mpv --speed=<speed> <file>

$ speed: echo -e "1.5\n2.0\n0.5\n1.25"

# Play with subtitles
mpv --sub-file=<srt> <file>

# Play audio only (no video)
mpv --no-video <file>

# Loop playback
mpv --loop <file>

# Start at position
mpv --start=<time> <file>

# Play YouTube URL
mpv <url>

# Screenshot mode (s key)
mpv --screenshot-directory=<dir> <file>

% whisper, transcription

# Transcribe with whisper
wh <file>

% ytdl, download

# Download video (best quality, mkv)
ytdl <url>

# Download audio (opus, default)
ytdl -a <url>

# Download audio as mp3
ytdl -a -f mp3 <url>

# Download 1080p video as mp4
ytdl -q 1080 -f mp4 <url>

# Download 720p video
ytdl -q 720 <url>

# Download with whisper transcription
ytdl -w <url>

# Download to specific directory
ytdl -o <dir> <url>

# Download without subtitles
ytdl -s <url>

# List available formats
ytdl -F <url>

# Dry run (show command)
ytdl -n <url>

# Pass extra args to yt-dlp
ytdl -- --geo-bypass <url>

# Quick audio download (alias)
ytdlm <url>

# Background download from clipboard
ytdlbg
